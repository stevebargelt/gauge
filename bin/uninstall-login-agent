#!/usr/bin/env bash
# Stops gauge's launchd user agent and removes its definition. Logs are kept.
set -euo pipefail

LABEL="io.github.stevebargelt.gauge"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"

launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
rm -f "$PLIST"
echo "gauge's login agent is removed (logs remain in $HOME/Library/Logs/gauge)"
